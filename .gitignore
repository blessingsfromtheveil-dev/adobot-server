# Secrets / local configuration
.env
.env.*
!.env.example
config/.env
config/.env.*
!config/.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Runtime state
run/
log/
logs/
*.pid
*.lock
*.sock
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Temporary / staging material
tmp/
tmp-wheel-test/
.cache/
*.tmp
*.bak
*.bak.*
*.swp
*.swo

# Production evidence contains runtime/process metadata and
# potentially sensitive operational material.
evidence/

# Local promotion / migration artifacts
.adobot_telegram.promoted-*/
*.promoted-*/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Credentials / cryptographic material
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*token*
*secret*
*credential*

# Termux-local artifacts
.termux/
